{
  "name": "nuvio-lite-tizen3",
  "version": "1.0.0",
  "description": "Lightweight pure ES5 streaming app for Samsung Tizen 3.0",
  "main": "start-dev.js",
  "packageType": "app",
  "appName": "Nuvio TV Lite",
  "appPath": "tizen-app/index.html",
  "keys": ["MediaPlay", "MediaPause", "MediaPlayPause", "MediaStop", "MediaFastForward", "MediaRewind", "MediaTrackPrevious", "MediaTrackNext"],
  "serviceFile": "tizenbrew-service.js",
  "evaluateScriptOnDocumentStart": false,
  "scripts": {
    "start": "node start-dev.js",
    "package": "node scripts/package_wgt.js",
    "verify": "node scripts/verify_es5.js"
  },
  "author": "Nuvio Lite Team",
  "license": "MIT"
}
